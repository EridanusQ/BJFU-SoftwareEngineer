@startuml L3_Component_Reservation
title NekoCafé C4 L3 - Reservation Service Components
left to right direction
skinparam componentStyle rectangle
actor "顾客端/BFF" as Client
component "Reservation API Controller\nREST /reservations" as Controller
component "Reservation Application Service\n编排创建/改期/取消" as AppSvc
component "Availability Query\n可预约时段查询" as Availability
component "Capacity Lock Manager\nRedis 幂等锁/TTL" as Lock
component "Reservation Domain\nReservation/Waitlist/Policy" as Domain
component "Reservation Repository\nPostgreSQL" as Repo
component "Outbox Publisher\nReservation Events" as Outbox
component "Notification Port" as NotifyPort
component "Member Client" as MemberClient
component "Store Client" as StoreClient
component "Cat Client" as CatClient
database "reservation_db" as DB
queue "reservation-events" as Events
Client --> Controller : REST JSON
Controller --> AppSvc
AppSvc --> MemberClient : 校验会员/隐私授权
AppSvc --> StoreClient : 桌位/营业规则
AppSvc --> CatClient : 猫咪状态
AppSvc --> Availability
AppSvc --> Lock : 锁定 tableId+timeSlot
AppSvc --> Domain : 创建/改期/取消
Domain --> Repo
Repo --> DB
AppSvc --> Outbox
Outbox --> Events
AppSvc --> NotifyPort : 发送确认/异常通知
note bottom of Lock
防止同桌位同一时段重复确认；
锁失败时返回候补建议。
end note
@enduml
