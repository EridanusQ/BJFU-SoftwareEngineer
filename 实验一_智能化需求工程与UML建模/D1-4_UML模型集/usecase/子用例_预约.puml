@startuml
left to right direction
skinparam backgroundColor #F6FBF8
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
actor "顾客/会员" as Customer
actor "店员" as Staff
actor "支付平台" as Payment
actor "短信/消息服务" as Message
rectangle "预约子系统" {
  usecase "UC-01\n查询门店/时段/桌型" as Search
  usecase "UC-02.1\n查看猫咪出勤与互动限制" as CatSchedule
  usecase "UC-02.2\n创建预约" as Create
  usecase "UC-02.3\n锁定桌位库存" as Lock
  usecase "UC-02.4\n订金支付" as Deposit
  usecase "UC-03.1\n改签/取消/退款" as Change
  usecase "UC-03.2\n候补登记" as Waitlist
  usecase "UC-07\n到店核销与迟到处理" as CheckIn
  usecase "UC-12.1\n预约通知提醒" as Notify
}
Customer --> Search
Customer --> CatSchedule
Customer --> Create
Customer --> Change
Customer --> Waitlist
Staff --> CheckIn
Payment --> Deposit
Message --> Notify
Create ..> Search : <<include>>
Create ..> CatSchedule : <<include>>
Create ..> Lock : <<include>>
Create ..> Deposit : <<include>>
Create ..> Notify : <<include>>
Search ..> Waitlist : <<extend>>\n满座
Create ..> Change : <<extend>>\n规则允许
CheckIn ..> Notify : <<include>>
@enduml
