@startuml
left to right direction
skinparam backgroundColor #F6FBF8
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
actor "会员" as Member
actor "运营人员" as Ops
actor "短信/消息服务" as Message
rectangle "会员子系统" {
  usecase "UC-05.1\n手机号/微信登录绑定" as Login
  usecase "UC-05.2\n维护会员档案与偏好" as Profile
  usecase "UC-05.3\n查看等级权益" as Level
  usecase "UC-05.4\n积分流水与兑换" as Points
  usecase "UC-05.5\n优惠券校验使用" as Coupon
  usecase "UC-05.6\n评价历史与复购" as Review
  usecase "UC-05.7\n隐私授权管理" as Consent
  usecase "UC-06\n个性化推荐" as Recommend
  usecase "UC-12.3\n差评工单触发" as Ticket
}
Member --> Login
Member --> Profile
Member --> Level
Member --> Points
Member --> Coupon
Member --> Review
Member --> Consent
Member --> Recommend
Ops --> Level
Ops --> Coupon
Ops --> Ticket
Message --> Login
Profile ..> Consent : <<include>>
Recommend ..> Profile : <<include>>
Coupon ..> Level : <<include>>
Review ..> Ticket : <<extend>>
@enduml
